# Shopify Storefront API Credentials
# Replace with your shopify store domain (e.g., your-store.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=

# Replace with your public Storefront API Access Token
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin API Credentials (SERVER-ONLY - Never expose to client/browser or prefix with VITE_)
SHOPIFY_SHOP=ssdsports
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

